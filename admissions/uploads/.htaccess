# Protect uploaded files - only allow direct access to images
# NRC and Results files should only be accessible through PHP scripts

# Deny access to NRC and Results folders
<FilesMatch "\.(pdf|jpg|jpeg|png)$">
    <IfModule mod_authz_core.c>
        # Apache 2.4
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow access to profile images only
<If "%{REQUEST_URI} =~ m#/profile_images/#">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</If>
