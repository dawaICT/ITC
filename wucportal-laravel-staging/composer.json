{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wuc/wucportal",
    "type": "project",
    "description": "WUC Portal — Laravel 11 — Student and Staff Administration Portal",
    "keywords": ["laravel", "education", "portal"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.31",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "spatie/laravel-permission": "^6.0",
        "phpmailer/phpmailer": "^6.8",
        "guzzlehttp/guzzle": "^7.12.1",
        "guzzlehttp/psr7": "^2.12.1",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "audit": {
        "ignore": [
            "PKSA-m5cs-t1y6-qpcs",
            "PKSA-3r5d-mb8f-1qw9",
            "PKSA-mdq4-51ck-6kdq",
            "PKSA-8qx3-n5y5-vvnd",
            "PKSA-q46n-4fdk-zjr4",
            "PKSA-qzrn-rnz3-85w1",
            "PKSA-cv56-2228-pzr6",
            "PKSA-6r8f-nxsb-67bq",
            "PKSA-gh7h-hhy4-byg7",
            "PKSA-mwt3-h9tv-kx78",
            "PKSA-hp6n-n4kz-21wk",
            "PKSA-mckv-s5hg-868k"
        ]
    }
}
