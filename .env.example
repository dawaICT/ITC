APP_ENV=production
WUC_PUBLIC_URL=https://portal.example.edu
WUC_DEBUG=0
WUC_DB_HOST=127.0.0.1
WUC_DB_PORT=3306
WUC_DB_NAME=wucportal
WUC_DB_USER=wucportal_app
WUC_DB_PASSWORD=replace-with-a-long-random-secret
WUC_PUBLIC_DB_USER=itc_public
WUC_PUBLIC_DB_PASSWORD=replace-with-a-separate-read-only-secret
WUC_LOG_DIR=C:\xampp\wucportal-var\logs
WUC_CACHE_DIR=C:\xampp\wucportal-var\cache
# Set to 1 to log every request timing; slow requests (>= WUC_PERF_SLOW_MS) always log.
WUC_PERF_LOG=0
WUC_PERF_SLOW_MS=800
WUC_BACKUP_DIR=C:\xampp\wucportal-var\backups
WUC_BACKUP_RETENTION_DAYS=30
WUC_BACKUP_REPLICA_DIR=D:\wucportal-offsite-replica
WUC_BACKUP_ENCRYPTED_AT_REST=1
WUC_HEALTH_TOKEN=replace-with-a-long-random-secret
ENTERPRISE_AI_ENABLED=false
# Local Ollama (recommended for enterprise AI drafting when cloud keys are unavailable)
WUC_AI_BACKEND=local
WUC_AI_CHAT_MODEL=llama3.2:3b
# Optional: WUC_AI_CLOUD_API_KEY=... or ai/cloud_key.txt for Groq cloud fallback
ENTERPRISE_EXHIBITION_MODE=false
ENTERPRISE_PORTAL_ENABLED=true
ENTERPRISE_MEMBERSHIP_APPROVAL_MODE=manual
ENTERPRISE_ALLOW_CURRENT_STUDENTS=true
ENTERPRISE_ALLOW_GRADUATES=true
ENTERPRISE_PUBLIC_DIRECTORY=true
ENTERPRISE_MONETIZATION_ENABLED=false
ENTERPRISE_PAID_FEATURED_LISTINGS=false
ENTERPRISE_TRANSACTION_COMMISSION_ENABLED=false
ENTERPRISE_SEED_ENABLED=false
ENTERPRISE_DEPLOYMENT_MODE=integrated
# Standalone product branding (optional; standalone defaults to Skills and Enterprise Network)
# ENTERPRISE_PLATFORM_NAME=Skills and Enterprise Network
# ENTERPRISE_PLATFORM_TAGLINE=Connecting Skills, Farmers, Businesses and Markets
ENTERPRISE_AGRICULTURE_ENABLED=true
AGRICULTURE_OFFICIAL_PRICE_APPROVAL_MODE=dual
ENTERPRISE_SMS_PROVIDER=mock
# ENTERPRISE_SMS_WEBHOOK_SECRET=
ENTERPRISE_USSD_PROVIDER=simulator
# ENTERPRISE_USSD_WEBHOOK_SECRET=
WUC_SCHOOLPAY_WEBHOOK_ENABLED=0
WUC_SCHOOLPAY_API_PASSWORD=
WUC_OPERATIONS_CONFIG=C:\xampp\wucportal-var\config\operations.php
WUC_MIGRATION_DB_USER=wucportal_migrator
WUC_MIGRATION_DB_PASSWORD=replace-with-a-separate-long-random-secret
WUC_BACKUP_DB_USER=wucportal_backup
WUC_BACKUP_DB_PASSWORD=replace-with-a-separate-long-random-secret
