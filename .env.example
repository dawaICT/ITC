APP_ENV=production
WUC_PUBLIC_URL=https://portal.example.edu
WUC_DEBUG=0
WUC_DB_HOST=127.0.0.1
WUC_DB_PORT=3306
WUC_DB_NAME=wucportal
WUC_DB_USER=wucportal_app
WUC_DB_PASSWORD=replace-with-a-long-random-secret
WUC_LOG_DIR=C:\xampp\wucportal-var\logs
WUC_BACKUP_DIR=C:\xampp\wucportal-var\backups
WUC_BACKUP_RETENTION_DAYS=30
WUC_BACKUP_REPLICA_DIR=D:\wucportal-offsite-replica
WUC_BACKUP_ENCRYPTED_AT_REST=1
WUC_HEALTH_TOKEN=replace-with-a-long-random-secret
WUC_OPERATIONS_CONFIG=C:\xampp\wucportal-var\config\operations.php
WUC_MIGRATION_DB_USER=wucportal_migrator
WUC_MIGRATION_DB_PASSWORD=replace-with-a-separate-long-random-secret
WUC_BACKUP_DB_USER=wucportal_backup
WUC_BACKUP_DB_PASSWORD=replace-with-a-separate-long-random-secret
